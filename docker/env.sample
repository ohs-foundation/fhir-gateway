# Sample environment for the Docker Compose files in this directory.
#
# Copy this file to `.env` (in this same directory) and adjust the values:
#
#   cp docker/env.sample docker/.env
#
# Docker Compose reads `.env` from the directory of the first `-f` compose file.
# `.env` is ignored by git, so it is safe to put real values (e.g., URLs of
# your own servers) there; never add secrets to this sample file.

TOKEN_ISSUER="http://localhost:9080/auth/realms/test"
PROXY_TO="http://localhost:8099/fhir"
BACKEND_TYPE="HAPI"
ACCESS_CHECKER="list"
RUN_MODE="PROD"
ALLOWED_QUERIES_FILE=""
# Uncomment to write AuditEvents to a separate FHIR store instead of PROXY_TO.
# AUDIT_EVENT_ACTIONS_CONFIG="CRUDE"
# AUDIT_EVENT_SINK_URL="http://localhost:8098/fhir"
# AUDIT_EVENT_SINK_AUTH_TYPE="none"
