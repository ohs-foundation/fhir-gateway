# Sample environment for the Keycloak Docker Compose file in this directory.
#
# Copy this file to `.env` (in this same directory) and adjust the values:
#
#   cp docker/keycloak/env.sample docker/keycloak/.env
#
# `.env` is ignored by git. The credentials below are for a local test instance
# only; set your own in `.env` and never add real secrets to this sample file.

HTTP_PORT="9080"
HTTPS_PORT="9443"
KEYCLOAK_USER="admin"
KEYCLOAK_PASSWORD="adminpass"
TEST_REALM="test"
TEST_USER="testuser"
TEST_PASS="testpass"
SMART_REALM="test-smart"
SMART_PATIENT_ID="8eb95e44-627f-4899-9ea3-097d4f7be57b"
